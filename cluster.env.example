# cluster.env — describe your 4x DGX Spark ring. Copy to cluster.env and edit.
# Nodes in RING ORDER: node i's port-0 (enp1s0f0np0/enP2p1s0f0np0) is cabled to node i+1's port-1.
# `./install.sh cabling` prints the actual cabling so you can fill this in (it uses fabric/lldp.py).
NODE_LAN=(192.0.2.11 192.0.2.12 192.0.2.13 192.0.2.14)   # management/LAN address of rank 0..3 (example values)
NODE_USER=$USER                               # same user and home directory on every node

# Model
HF_REPO=dealignai/DeepSeek-V4.1-Flash-1017-UNCENSORED-FP8
HF_REVISION=c19ca5ca4eaeb79d29fdf08aea8327da95b1116a
MODEL_DIR=$HOME/models/DSV41-UNC-FP8          # same path on every node (full local copy)
ENGRAM_DIR=$HOME/dsv41-engram                 # packed Engram rows, local NVMe on every node
SERVED_MODEL_NAME=DeepSeek-V4.1-Flash-1017-UNCENSORED
PORT=8888                                     # the API listens on every interface of the head (0.0.0.0:PORT)
API_KEY=                                      # optional: clients then send "Authorization: Bearer <key>"; set it before exposing the port beyond your LAN

# Pinned software (what docs/RESULTS.md was measured on)
KERNEL=6.17.0-1032-nvidia                     # needs PCIe LTR+ (older 1014 / 7.0.0-1019 cap CX7 TX at 12.8 Gb/s)
ENGINE_REPO=https://github.com/knapcio/DeepSeek-V4.1-Flash-4x-DGX-Spark-TP4.git
ENGINE_COMMIT=506fb10
BASE_IMAGE_DIGEST=lmsysorg/sglang:dev-dsv41@sha256:b4a4745fab5393dc0aca573fe754b86477f57691c9e971390b21102d3d94ebf9
SPARKRING_COMMIT=f16b5f4
WORK=$HOME/dsv41                              # clones, builds
