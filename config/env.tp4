# .env.tp4 — DeepSeek-V4.1-Flash-1017 UNCENSORED FP8, TP4 on the 4x DGX Spark switchless ring.
# Engine: knapcio/DeepSeek-V4.1-Flash-4x-DGX-Spark-TP4 @ 506fb10 + patches/knapcio-506fb10-dsv411017.patch,
# 4-HCA ring NCCL + hardware-forwarded RoCEnante mesh (engine docs/switchless-ring.md).
# install.sh engine copies this to <engine>/.env.tp4 and fills in @NODE_USER@ and @HOME@ from cluster.env.
#
# Ring: rk1 -> rk2 -> rk3 -> rk4 -> rk1 (f0 port to next node's f1), one /24 per cable per PCIe function
# (10.10.{2r,2r+1}.0/24). Node IPs 10.10.100.{1..4}/32 live on dummy iface ring0 and are routed over the
# fabric (opposite node through the clockwise neighbour), so Gloo / NCCL bootstrap / ssh never touch Wi-Fi.

# ─── cluster ──────────────────────────────────────────────────────────────────
HEAD_IP=10.10.100.1
WORKER_IPS="10.10.100.2 10.10.100.3 10.10.100.4"
WORKER_HOSTS="rk2 rk3 rk4"
WORKER_USER=@NODE_USER@
SSH_IDENTITY=$HOME/.ssh/id_ed25519
GLOO_SOCKET_IFNAME=ring0
NCCL_SOCKET_IFNAME=ring0

# ─── NCCL: ring-only, all four RDMA functions ─────────────────────────────────
IB_HCA=rocep1s0f0,roceP2p1s0f0,rocep1s0f1,roceP2p1s0f1
NCCL_NET=IB
NCCL_IB_DISABLE=0
NCCL_P2P_DISABLE=1
NCCL_SHM_DISABLE=1
NCCL_DEBUG=WARN
NCCL_DEBUG_SUBSYS=INIT,ENV,NET
NCCL_BUFFSIZE=1048576
NCCL_LL128_BUFFSIZE=262144
NCCL_PROTO=^LL128
NCCL_HOST_DIR=/opt/nccl-switchless-4hca-fence
NCCL_SWITCHLESS_RING_ONLY=1
NCCL_ALGO=Ring
NCCL_IB_SUBNET_PREFIX_LEN=24
NCCL_MIN_NCHANNELS=4
NCCL_MAX_NCHANNELS=4
NCCL_P2P_LEVEL=SYS
NCCL_IB_GID_INDEX=3

# ─── model / image ────────────────────────────────────────────────────────────
MODEL_DIR=@HOME@/models/DSV41-UNC-FP8
COMMON_MODEL=/var/tmp/DSV41-UNC-FP8
SERVED_MODEL_NAME=DeepSeek-V4.1-Flash-1017-UNCENSORED
BASE_IMAGE=dsv41-base:knap25-flat
IMAGE=dsv41-4x-spark:knap25s
BUILD_DOCKERFILE=Dockerfile.canary-roce
PORT=8888
API_KEY=

# Local full checkpoint on every node; workers mount it through a bind volume.
NFS_SHARE=0
NFS_VOLUME=dsv41-local-weights

NNODES=4
TP_SIZE=4
EP_SIZE=1
DIST_PORT=20000

# ─── Engram (NVMe, packed per rank) ───────────────────────────────────────────
OFFLOAD_MODE=nvme
DSV41_CACHE_GIB=2
DSV41_IO_THREADS=96
DSV41_RESIDENT_SCALES=0
DSV41_CACHE_WAYS=16
DSV41_STATS_SECONDS=60
ENGRAM_DIR=@HOME@/dsv41-engram
WORKER_DIR=@HOME@/dsv41-4x
WORKER_ENGRAM_DIR=@HOME@/dsv41-engram
DSV41_PACKED_DIR=/engram

# ─── runtime ──────────────────────────────────────────────────────────────────
CONTEXT_LENGTH=1048576
MEM_FRACTION_STATIC=0.86
HEAD_MEM_FRACTION_STATIC=0.86
MAX_RUNNING_REQUESTS=8
CHUNKED_PREFILL_SIZE=8192
# KV pool pinned to 4,259,840 tokens (4 x 1M sessions + headroom; ~2.05 KB/token/rank). Unpinned it
# floats with free memory at boot (3.9M-4.59M measured) and a 4th 1M session may not fit. The 0.86
# fraction only guarantees every boot reaches the pin; the pin is what bounds memory.
MAX_TOTAL_TOKENS=4259840
SPEC_ALGO=DSPARK
DSPARK_BLOCK_SIZE=5
DSPARK_SPS_TABLE=/state/dspark_sps.json
DSPARK_STS_TABLE=/state/dspark_sts.json
SKIP_PREPARE=1
SKIP_VERIFY=1
SKIP_SMOKE=0
SMOKE_QUICK=0
EXTRA_SGLANG_ARGS="--fp8-gemm-backend flashinfer_cutlass --watchdog-timeout 1800 --min-free-slots-delay 1 --enable-deepseek-v4-fp4-indexer --enable-cache-report --sleep-on-idle --swa-prefix-tails 128 --prefill-decode-interval 8 --prefill-decode-interval-min-bs 1 --enable-metrics"
DSV41_MXFP8_BACKEND=b12x
DSV41_SHARED_PAD_K=1
SGLANG_FLASHINFER_MOE_FUSED_FINALIZE=0
SGLANG_DSV41_REASONING_EFFORT=75
DSV41_MAX_NEW_TOKENS=32768
DSV41_LOOP_ABORT=1
DSV41_LOOP_NGRAM=32
DSV41_LOOP_REPEATS=4
DSV41_LOOP_LINE_REPEATS=8
# expandable_segments:True gives NaN logits on this stack; do not add max_split_size_mb either (prefill
# scratch is then not reused and reserved memory runs away). Long-prefill memory: adapter/prefill_empty_cache.py.
PYTORCH_CUDA_ALLOC_CONF=expandable_segments:False
DSV41_TP_PAD=0

# Production line + ring mesh (scripts/ring_mesh/plan.py env.txt, hairpin 8192 -> 256 KB RoCE cap).
EXTRA_CONTAINER_ENV="DSV41_INDEXER_LOGITS_BUDGET_BYTES=1073741824 DSV41_INDEXER_CHUNKED=1 SGLANG_DSPARK_FOLDED_SAMPLING=2 B12X_ROCE_CACHE_DIR=/state/b12x-roce B12X_COMPILE_CACHE_DIR=/state/b12x-compile SPARK_PREFILL_TP_SPLIT=1 SPARK_PREFILL_TP_MIN_CONTEXT=32768 SPARK_PREFILL_TP_MIN_ROWS=1024 SGLANG_RUST_BUILD_MODE=never DSV41_FAST_LOAD=1 DSV41_FAST_LOAD_EP_SIZE=1 DSV41_FAST_LOAD_TP_SLICE=auto DSV41_FAST_LOAD_N_EXPERTS=384 DSV41_FAST_LOAD_INFLIGHT_GB=6 DSV41_ENGRAM_PREFETCH=1 DSV41_WO_A_W8=1 DSV41_DRAFT_TAU=0.7 DSV41_DRAFT_HEAD_FP8=1 DSV41_BLOCK_VERIFY=1 DSV41_FOLDED_FENCE=1 DSV41_VERIFY_CAP=conf:0.1 DSV41_AUTOTUNE_KEEP=1 DSV41_WO_A_W8_MID=1 DSV41_WO_A_W8_DROP=1 DSV41_REPLICATED_SPLIT=wqkv_a,engram.wkv DSV41_DRAFT_MAIN_PROJ_SPLIT=1 DSV41_ROUTER_LIVE=1 DSV41_MOE_B12X_NEXT=1 DSV41_MOE_B12X_NEXT_DETERMINISTIC=1 DSV41_HC_FUSED=1 DSV41_PREFILL_SP=1 DSV41_PREFILL_SP_FP8=1 DSV41_L2_PREFETCH=1 DSV41_L2_PREFETCH_WOA=1 DSV41_SPEC_SYNC_FREE=all DSV41_EAGER_GLUE=all DSV41_SPLIT_COMPACT_GATHER=1 DSV41_CERT_HEAD=1 DSV41_CERT_HEAD_M=6,12,18,24,30,36,42,48 DSV41_PREFILL_BYPASS=4096 DSV41_ENGRAM_KEEPALIVE_MS=25 DSV41_SWA_EVICT_INTERNAL_FIRST=1 DSV41_SWA_KEEP_TOKENS=8704 DSV41_SWA_PROMPT_TAIL_KEEP=1024 DSV41_ROCE_RING=1 SGLANG_ROCE_ALLREDUCE=1 SGLANG_ROCE_MAX_SIZE=262144 DSV41_ROCE_GATHER=262144 B12X_ROCE_HCA=rocep1s0f0,rocep1s0f1,roceP2p1s0f0,roceP2p1s0f1 B12X_ROCE_PEER_HCA_MAPS=1=0/2,2=0/3,3=1/3;0=1/3,2=0/2,3=0/3;0=1/2,1=1/3,3=0/2;0=0/2,1=1/2,2=1/3 B12X_ROCE_TWO_WAVE_THRESHOLD_BYTES=0"

# NCCL-only fallback (no mesh): replace the last five ring-mesh entries above with SGLANG_ROCE_ALLREDUCE=0
# and drop DSV41_ROCE_RING / DSV41_ROCE_GATHER / B12X_ROCE_*; leave DSV41_L2_PREFETCH off then.
