 logger = logging.getLogger(__name__)
+_GIB = 1 << 30
+_TRIM = int(float(os.environ.get('DSV41_PREFILL_TRIM_GIB', '1')) * _GIB)
+_TRIM_EVERY_S = float(os.environ.get('DSV41_PREFILL_TRIM_EVERY_S', '10'))
