diff --git a/tests/test_swa_evict_internal_first.py b/tests/test_swa_evict_internal_first.py
new file mode 100644
index 0000000..1aa0e73
--- /dev/null
+++ b/tests/test_swa_evict_internal_first.py
@@ -0,0 +1,194 @@
+"""CPU test for adapter/swa_evict_internal_first.py with a stub SWARadixCache (same attribute/API names).
+
+Run: DSV41_SWA_EVICT_INTERNAL_FIRST=1 python3 tests/test_swa_evict_internal_first.py
+"""
+import dataclasses, os, sys, types
+os.environ["DSV41_SWA_EVICT_INTERNAL_FIRST"] = "1"
+sys.path.insert(0, os.path.join(os.path.dirname(__file__), "..", "adapter"))
+
+# minimal stand-in for sglang.srt.mem_cache.base_prefix_cache.EvictResult
+bpc = types.ModuleType("sglang.srt.mem_cache.base_prefix_cache")
+@dataclasses.dataclass
+class EvictResult:
+    num_tokens_evicted: int = 0
+    swa_num_tokens_evicted: int = 0
+    mamba_num_evicted: int = 0
+@dataclasses.dataclass
+class EvictParams:
+    num_tokens: int = 0
+    swa_num_tokens: int = 0
+    mamba_num: int = 0
+bpc.EvictResult = EvictResult
+for name in ("sglang", "sglang.srt", "sglang.srt.mem_cache"):
+    sys.modules.setdefault(name, types.ModuleType(name))
+sys.modules["sglang.srt.mem_cache.base_prefix_cache"] = bpc
+
+import swa_evict_internal_first as ad
+
+
+class Node:
+    _id = 0
+    def __init__(self, n, parent=None):
+        Node._id += 1; self.id = Node._id
+        self.value = list(range(n)); self.key = self.value
+        self.children = {}; self.parent = parent
+        self.swa_tombstone = False; self.swa_lock_ref = 0; self.full_lock_ref = 0
+        if parent is not None: parent.children[self.id] = self
+
+
+class LRU:  # oldest first; mirrors get_lru_no_lock / get_prev_no_lock / remove_node / in_list
+    def __init__(self, nodes): self.order = list(nodes)
+    def get_lru_no_lock(self): return next((n for n in self.order if n.swa_lock_ref == 0), None)
+    def get_prev_no_lock(self, node):
+        i = self.order.index(node)
+        return next((n for n in self.order[i + 1:] if n.swa_lock_ref == 0), None)
+    def remove_node(self, node): self.order.remove(node)
+    def in_list(self, node): return node is not None and node in self.order
+
+
+class Alloc:
+    def __init__(self): self.freed = 0
+    def free_swa_segment(self, value, start_pos=0): self.freed += len(value)
+
+
+class SWARadixCache:
+    def __init__(self, root, nodes):
+        self.root_node = root; self.disable = False; self.sliding_window_size = 128; self.page_size = 256
+        self.swa_lru_list = LRU(nodes); self.token_to_kv_pool_allocator = Alloc(); self.swa_evictable_size_ = 0
+        self.orig_calls = []
+    def _tombstone_internal_node(self, node):
+        assert node.children; node.swa_tombstone = True
+    def update_eviction_metrics(self, n, t): pass
+    def evict(self, params):  # "original": records what is left for it
+        self.orig_calls.append(params)
+        return EvictResult(num_tokens_evicted=params.num_tokens, swa_num_tokens_evicted=params.swa_num_tokens)
+
+
+mod = types.SimpleNamespace(SWARadixCache=SWARadixCache)
+ad.install(mod)
+
+# Two sessions, each a chain of 3 chunk nodes of 512 SWA tokens + a 512-token leaf; session A is older.
+root = Node(0)
+def session():
+    a = Node(512, root); b = Node(512, a); c = Node(512, b); leaf = Node(512, c); return [a, b, c, leaf]
+A = session(); B = session()
+cache = SWARadixCache(root, A + B)          # LRU order: A's internals, A's leaf, B's internals, B's leaf
+
+# Need 2048 SWA tokens: the stock order would take A0,A1,A2 then A's LEAF (deleting session A).
+r = cache.evict(EvictParams(swa_num_tokens=2048))
+taken = [n for n in A + B if n.swa_tombstone]
+assert A[3] not in taken and B[3] not in taken, "a leaf was tombstoned"
+assert taken == [A[0], A[1], A[2], B[0]], [n.id for n in taken]
+assert r.swa_num_tokens_evicted == 2048 and cache.orig_calls == [], r
+print("PASS internal nodes of both sessions go before any leaf; no fallback needed")
+
+# Short-leaf protection: a 64-token leaf under an internal node -> that node is skipped.
+root2 = Node(0); p = Node(512, root2); short = Node(64, p); q = Node(512, root2); q2 = Node(512, q)
+c2 = SWARadixCache(root2, [p, short, q, q2])
+c2.evict(EvictParams(swa_num_tokens=512))
+assert not p.swa_tombstone and q.swa_tombstone, "parent of a short leaf must be kept"
+print("PASS parent of a < window+page leaf is protected")
+
+# Not enough internal SWA: the remainder goes to the original evict, full evictions pass through.
+root3 = Node(0); i3 = Node(512, root3); l3 = Node(512, i3)
+c3 = SWARadixCache(root3, [i3, l3])
+r3 = c3.evict(EvictParams(num_tokens=100, swa_num_tokens=1000))
+assert i3.swa_tombstone and c3.orig_calls == [EvictParams(num_tokens=100, swa_num_tokens=488)], c3.orig_calls
+assert r3.swa_num_tokens_evicted == 1000 and r3.num_tokens_evicted == 100, r3
+print("PASS remainder (and full-pool eviction) delegated to the original evict")
+
+# SWA not needed: untouched delegation.
+c4 = SWARadixCache(root3, [])
+c4.evict(EvictParams(num_tokens=7)); assert c4.orig_calls == [EvictParams(num_tokens=7)]
+print("PASS full-only eviction is passed through unchanged")
+print("all passed")
+
+
+# ---------------- unified cache (SWAComponent eviction walk) ----------------
+import enum
+class EvictLayer(enum.Enum):
+    DEVICE = 1
+class CD:
+    def __init__(self, n): self.value = list(range(n)); self.lock_ref = 0
+class UNode:
+    _id = 0
+    def __init__(self, n, parent=None):
+        UNode._id += 1; self.id = UNode._id; self.key = list(range(n)); self.children = {}; self.parent = parent
+        self.component_data = {"swa": CD(n)}
+        if parent is not None: parent.children[self.id] = self
+class ULRU:
+    def __init__(self, nodes): self.order = list(nodes)
+    def get_lru_no_lock(self): return next((n for n in self.order if n.component_data["swa"].lock_ref == 0), None)
+    def get_prev_no_lock(self, node, check_id=True):
+        i = self.order.index(node); return next((n for n in self.order[i + 1:] if n.component_data["swa"].lock_ref == 0), None)
+    def remove_node(self, node): self.order.remove(node)
+    def in_list(self, node): return node is not None and node in self.order
+class TreeCore:
+    def __init__(self, root, nodes):
+        self.root_node = root; self.page_size = 256; self.enable_session_radix_cache = False
+        self.lru_lists = {"swa": ULRU(nodes)}; self.deleted = []
+        self.evictable_device_leaves = {n for n in nodes if not n.children}
+    def _evict_component_and_detach_lru(self, x, comp, target, tracker, device_frees, host_frees):
+        tracker["swa"] += len(x.component_data["swa"].value); x.component_data["swa"].value = None
+        self.lru_lists["swa"].remove_node(x)
+    def _cascade_evict(self, x, comp, tracker, device_frees, host_frees): pass
+class SWAComponent:  # original walk, simplified to the same contract
+    component_type = "swa"; sliding_window_size = 128
+    def _evict_device_start(self, request_cnt):
+        self._evict_device_request_cnt = request_cnt; self._evict_device_cursor = self.tree_core.lru_lists["swa"].get_lru_no_lock()
+    def _evict_device_next_node(self, tracker, device_frees, host_frees):
+        lru = self.tree_core.lru_lists["swa"]; x = self._evict_device_cursor
+        if tracker["swa"] >= self._evict_device_request_cnt or x is None or not lru.in_list(x): return None
+        if x in self.tree_core.evictable_device_leaves:
+            self._evict_device_cursor = lru.get_prev_no_lock(x); return x.id
+        nxt = lru.get_prev_no_lock(x)
+        self.tree_core._evict_component_and_detach_lru(x, self, EvictLayer.DEVICE, tracker, device_frees, host_frees)
+        self._evict_device_cursor = nxt; return None
+
+def drive(comp, need):  # the driver loop of UnifiedRadixCache
+    from collections import defaultdict
+    tracker = defaultdict(int); deleted = []
+    comp._evict_device_start(need)
+    while True:
+        before = dict(tracker)
+        nid = comp._evict_device_next_node(tracker, {}, {})
+        if nid is None:
+            if tracker == before: break
+        else:
+            deleted.append(nid); node = next(n for n in comp.tree_core.lru_lists["swa"].order if n.id == nid)
+            tracker["swa"] += len(node.component_data["swa"].value); comp.tree_core.lru_lists["swa"].remove_node(node)
+    return tracker["swa"], deleted
+
+umod = types.SimpleNamespace(SWAComponent=SWAComponent, EvictLayer=EvictLayer)
+ad.install_unified(umod)
+uroot = UNode(0)
+def usession():
+    a = UNode(512, uroot); b = UNode(512, a); c = UNode(512, b); leaf = UNode(512, c); return [a, b, c, leaf]
+UA = usession(); UB = usession()
+comp = SWAComponent(); comp.tree_core = TreeCore(uroot, UA + UB)
+freed, deleted = drive(comp, 2048)
+assert deleted == [] and freed == 2048, (freed, deleted)
+assert [n for n in UA + UB if n.component_data["swa"].value is None] == [UA[0], UA[1], UA[2], UB[0]]
+print("PASS unified walk: internal chunk nodes of both sessions before any leaf (no session deleted)")
+comp2 = SWAComponent(); r2 = UNode(0); i2 = UNode(512, r2); l2 = UNode(512, i2); comp2.tree_core = TreeCore(r2, [i2, l2])
+freed2, deleted2 = drive(comp2, 1000)
+assert freed2 >= 1000 and deleted2 == [l2.id], (freed2, deleted2)
+print("PASS unified walk: falls back to the original leaf eviction when internals are exhausted")
+print("unified passed")
+
+
+# ---------------- prompt-tail SWA retain floor (UnifiedRadixCache.swa_retain_floor) ----------------
+ad._PT_KEEP = 1024
+class URC:
+    page_size = 256; _sliding_window_size = 128; _chunk = False; _mamba = None
+    def is_chunk_cache(self): return self._chunk
+    def swa_retain_floor(self, req): return self._mamba
+class R:
+    def __init__(self, n): self.origin_input_ids = list(range(n))
+ad.install_prompt_tail_floor(types.SimpleNamespace(UnifiedRadixCache=URC))
+c = URC()
+assert c.swa_retain_floor(R(5978)) == 5888 - 1024, c.swa_retain_floor(R(5978))      # page floor(5978)=5888, keep 1024
+assert c.swa_retain_floor(R(300)) == 0                                                # short prompt: keep everything
+c._mamba = 1000; assert c.swa_retain_floor(R(5978)) == 1000                           # an existing (mamba) floor wins if lower
+c._mamba = None; c._chunk = True; assert c.swa_retain_floor(R(5978)) is None          # chunk cache: unchanged
+print("PASS prompt-tail retain floor: page-aligned, clamped at 0, min() with an existing floor, chunk cache untouched")
