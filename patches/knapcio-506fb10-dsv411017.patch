+    def before_long(self):
+        torch.cuda.reset_peak_memory_stats()
+        self.base = torch.cuda.memory_allocated()
+
+    def after_long(self):
+        self.working = max(0, torch.cuda.max_memory_allocated() - self.base)
+
+    def after(self):
+        reserved, allocated = torch.cuda.memory_reserved(), torch.cuda.memory_allocated()
+        if reserved - allocated <= self.working + _TRIM:
+            return
+        now = time.monotonic()
+        if now - self.last < _TRIM_EVERY_S:
+            return
+        self.last = now
+        self.trims += 1
