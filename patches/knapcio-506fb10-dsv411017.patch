diff --git a/adapter/swa_evict_internal_first.py b/adapter/swa_evict_internal_first.py
new file mode 100644
index 0000000..1c0729a
--- /dev/null
+++ b/adapter/swa_evict_internal_first.py
@@ -0,0 +1,202 @@
+"""SWA eviction: tombstone internal radix nodes before evicting any leaf (DSV41_SWA_EVICT_INTERNAL_FIRST).
+
+Why (measured on the 4x Spark ring, 2026-10-24, CHUNKED_PREFILL_SIZE=8192): every chunk of a long
+prefill becomes a radix node that keeps ~512 SWA tokens (window 128 + page alignment), so one finished
+~1M session holds ~62.5k SWA tokens. `SWARadixCache.evict` walks a single LRU list over internal nodes
+and leaves. When a new long prefill needs SWA, it reaches the *leaf* of an older session before the
+*internal* chunk nodes of newer sessions, and evicting an unlocked leaf deletes it and cascades through
+its tombstoned ancestors, i.e. drops that whole session's full KV while the full pool is mostly free.
+Result without this adapter: with three ~1M sessions resident, every revisit was a 210 s re-prefill.
+
+What this changes: when SWA tokens must be freed, a first pass walks the same SWA LRU list (oldest
+first, unlocked nodes only, via the cache's own `get_lru_no_lock` / `get_prev_no_lock`) and applies the
+cache's own internal-node action -- `free_swa_segment` + `_tombstone_internal_node` -- to internal nodes
+only. The original `evict` then runs for whatever is still needed (and for all full-pool evictions),
+unchanged. No new state, no new freeing path: only the order of two existing actions.
+
+What is kept: internal nodes with a leaf closer than DSV41_SWA_KEEP_TOKENS below them are skipped in the
+first pass (live SWA tail per cached session). Measured on the ring (1M sessions, 256-token nodes,
+CHUNKED_PREFILL_SIZE=8192): keeping only window+page (384) left older sessions resident but unmatchable
+(A,B,A at 1M missed); keeping one prefill chunk + 2 pages (8704) retained them (A,B,A,C,B,A: every revisit
+2.7-3.4 s with 999k cached tokens). Set DSV41_SWA_KEEP_TOKENS = CHUNKED_PREFILL_SIZE + 512.
+
+Off unless DSV41_SWA_EVICT_INTERNAL_FIRST is set. Two installs, one per cache implementation:
+  - install(module)          sglang.srt.mem_cache.swa_radix_cache       SWARadixCache.evict
+  - install_unified(module)  sglang.srt.mem_cache.unified_cache.components.swa
+                             SWAComponent._evict_device_start / _evict_device_next_node
+The DSV4 serving path in this image uses the unified cache (Python tree core, metrics engine_type=unified);
+the SWARadixCache patch is kept for images that still use it.
+"""
+import dataclasses
+import os
+import time
+
+_ON = os.environ.get("DSV41_SWA_EVICT_INTERNAL_FIRST", "0").strip() not in ("0", "off", "false", "")
+# Live-SWA span kept above every leaf (tokens). Default: window + page. DSV41_SWA_KEEP_TOKENS overrides.
+_KEEP = int(os.environ.get("DSV41_SWA_KEEP_TOKENS", "0") or 0)
+_STATS = {"passes": 0, "tombstoned_nodes": 0, "tombstoned_tokens": 0, "skipped_near_leaf": 0}
+
+
+def _near_short_leaf(node, keep):
+    """True if some leaf lies fewer than `keep` tokens below `node` (its window reaches into `node`)."""
+    stack = [(node, keep)]
+    while stack:
+        n, budget = stack.pop()
+        for c in n.children.values():
+            key = getattr(c, "key", None)
+            length = len(key) if key is not None else len(getattr(c, "value", None) or ())
+            if length >= budget:
+                continue
+            if not c.children:
+                return True
+            stack.append((c, budget - length))
+    return False
+
+
+def install(module):
+    if not _ON:
+        return
+    cls = getattr(module, "SWARadixCache", None)
+    if cls is None or getattr(cls, "_dsv41_internal_first", False):
+        return
+    original_evict = cls.evict
+
+    def evict(self, params):
+        if self.disable or params.swa_num_tokens <= 0:
+            return original_evict(self, params)
+        start = time.perf_counter()
+        keep = _KEEP or (self.sliding_window_size + self.page_size)
+        need = params.swa_num_tokens
+        freed = 0
+        x = self.swa_lru_list.get_lru_no_lock()
+        while freed < need and self.swa_lru_list.in_list(x):
+            x_next = self.swa_lru_list.get_prev_no_lock(x)
+            if len(x.children) > 0 and not x.swa_tombstone and x.swa_lock_ref == 0 and x != self.root_node:
+                if _near_short_leaf(x, keep):
+                    _STATS["skipped_near_leaf"] += 1
+                else:
+                    # identical to the internal-node branch of SWARadixCache.evict
+                    self.token_to_kv_pool_allocator.free_swa_segment(x.value, start_pos=0)
+                    freed += len(x.value)
+                    self.swa_lru_list.remove_node(x)
+                    self._tombstone_internal_node(x)
+                    _STATS["tombstoned_nodes"] += 1
+                    _STATS["tombstoned_tokens"] += len(x.value)
+            x = x_next
+        _STATS["passes"] += 1
+        rest = dataclasses.replace(params, swa_num_tokens=max(0, need - freed))
+        if rest.num_tokens > 0 or rest.swa_num_tokens > 0 or getattr(rest, "mamba_num", 0) > 0:
+            result = original_evict(self, rest)
+        else:
+            from sglang.srt.mem_cache.base_prefix_cache import EvictResult
+            result = EvictResult()
+            self.update_eviction_metrics(freed, start)
+        result.swa_num_tokens_evicted += freed
+        if _STATS["passes"] % 200 == 1:
+            print(f"[swa_evict_internal_first] {_STATS}", flush=True)
+        return result
+
+    cls.evict = evict
+    cls._dsv41_internal_first = True
+    print(f"[swa_evict_internal_first] armed on {cls.__name__}.evict (keep window+page below internal nodes)", flush=True)
+
+
+def install_unified(module):
+    """Unified radix cache: two-phase SWA device-eviction walk.
+
+    Phase 1 walks the SWA LRU (same cursor API) and performs the walk's own internal-node step --
+    `_evict_component_and_detach_lru(target=DEVICE)` + `_cascade_evict` -- on internal nodes only,
+    one mutation per call (the driver drains frees and rechecks capacity between calls). When no
+    eligible internal node is left, phase 2 restarts the original walk at the LRU tail, unchanged.
+    Session-radix mode (cursor partitions) is left entirely to the original walk.
+    """
+    if not _ON:
+        return
+    cls = getattr(module, "SWAComponent", None)
+    if cls is None or getattr(cls, "_dsv41_internal_first", False):
+        return
+    orig_start = cls._evict_device_start
+    orig_next = cls._evict_device_next_node
+    EvictLayer = module.EvictLayer
+
+    def _evict_device_start(self, request_cnt):
+        orig_start(self, request_cnt)
+        self._dsv41_phase = 2 if self.tree_core.enable_session_radix_cache else 1
+
+    def _evict_device_next_node(self, tracker, device_frees, host_frees):
+        if getattr(self, "_dsv41_phase", 2) == 1:
+            ct = self.component_type
+            lru = self.tree_core.lru_lists[ct]
+            if tracker[ct] >= self._evict_device_request_cnt:
+                return None
+            keep = _KEEP or (self.sliding_window_size + self.tree_core.page_size)
+            x = self._evict_device_cursor
+            if x is not None and not lru.in_list(x):
+                x = lru.get_lru_no_lock()
+            while x is not None and lru.in_list(x):
+                x_next = lru.get_prev_no_lock(x)
+                cd = x.component_data[ct]
+                if (len(x.children) > 0 and cd.value is not None and cd.lock_ref == 0
+                        and x is not self.tree_core.root_node):
+                    if _near_short_leaf(x, keep):
+                        _STATS["skipped_near_leaf"] += 1
+                    else:
+                        _STATS["tombstoned_nodes"] += 1
+                        _STATS["tombstoned_tokens"] += len(cd.value)
+                        self.tree_core._evict_component_and_detach_lru(
+                            x, self, target=EvictLayer.DEVICE, tracker=tracker,
+                            device_frees=device_frees, host_frees=host_frees)
+                        self.tree_core._cascade_evict(
+                            x, self, tracker, device_frees=device_frees, host_frees=host_frees)
+                        self._evict_device_cursor = x_next
+                        return None
+                x = x_next
+            # no eligible internal node left: original walk from the LRU tail
+            _STATS["passes"] += 1
+            if _STATS["passes"] % 50 == 1:
+                print(f"[swa_evict_internal_first] {_STATS}", flush=True)
+            self._dsv41_phase = 2
+            self._evict_device_cursor = lru.get_lru_no_lock()
+        return orig_next(self, tracker, device_frees, host_frees)
+
+    cls._evict_device_start = _evict_device_start
+    cls._evict_device_next_node = _evict_device_next_node
+    cls._dsv41_internal_first = True
+    print("[swa_evict_internal_first] armed on unified SWAComponent eviction walk "
+          "(internal nodes first, keep window+page above short leaves)", flush=True)
+
+
+_PT_KEEP = int(os.environ.get("DSV41_SWA_PROMPT_TAIL_KEEP", "0") or 0)
+
+
+def install_prompt_tail_floor(module):
+    """DSV41_SWA_PROMPT_TAIL_KEEP=N: keep the last N prompt tokens' SWA through decode (UnifiedRadixCache.swa_retain_floor).
+
+    A prompt shorter than one prefill chunk is not inserted into the radix tree before it finishes, so during decode
+    `free_swa_out_of_window_slots` frees its SWA up to seqlen - window -- including the prompt's end. The finished
+    insert then tombstones the prompt end, and a revisit (or a turn that diverges after the prompt) cannot end its
+    match there: measured 0 cached tokens on the 2nd visit of a 6k prompt, hits only from the 3rd visit on.
+    `swa_retain_floor` is SGLang's own hook for this (the mamba path uses checkpoint - window); the decode-time
+    eviction promises not to free past it. Returning page_floor(prompt) - N keeps that window live; slots are only
+    freed later than before, never earlier. Cost: <= N SWA tokens per running request.
+    """
+    if _PT_KEEP <= 0:
+        return
+    cls = getattr(module, "UnifiedRadixCache", None)
+    if cls is None or getattr(cls, "_dsv41_prompt_tail", False):
+        return
+    orig = cls.swa_retain_floor
+
+    def swa_retain_floor(self, req):
+        base = orig(self, req)
+        if self._sliding_window_size is None or self.is_chunk_cache():
+            return base
+        prompt = len(getattr(req, "origin_input_ids", None) or ())
+        if prompt <= 0:
+            return base
+        floor = max(0, (prompt // self.page_size) * self.page_size - _PT_KEEP)
+        return floor if base is None else min(base, floor)
+
+    cls.swa_retain_floor = swa_retain_floor
+    cls._dsv41_prompt_tail = True
+    print(f"[swa_prompt_tail] armed: decode keeps the last {_PT_KEEP} prompt tokens' SWA (prompt-end revisits match)", flush=True)
