@@ -0,0 +1,57 @@
+"""Extra model ids for the served model (DSV41_MODEL_ALIASES=name1,name2,...).
+
+Chat completions and Anthropic messages already accept any `model` value. The Responses API rejects ids other
+than the served name with 404, and `/v1/models` lists only the served name, so clients that pick a model from the
+list or validate it (and Responses clients) cannot use a shorter id. With aliases set:
+- `/v1/responses` accepts every alias;
+- `/v1/models` lists each alias as its own model card (root = the served model);
+- `/v1/models/<alias>` resolves.
+Responses still report the id the client sent. Nothing else changes.
+"""
+import logging
+import os
+
+logger = logging.getLogger(__name__)
+ALIASES = [a.strip() for a in os.environ.get("DSV41_MODEL_ALIASES", "").split(",") if a.strip()]
+
+
+def install_responses(module):
+    cls = getattr(module, "OpenAIServingResponses", None)
+    if cls is None or getattr(cls, "_dsv41_aliases", False):
+        return
+    orig = cls._known_model_names
+
+    def _known_model_names(self):
+        return orig(self) | set(ALIASES)
+
+    cls._known_model_names = _known_model_names
+    cls._dsv41_aliases = True
+
+
+def install_http(module):
+    from fastapi.routing import APIRoute
+
+    orig_list, orig_get = module.available_models, module.retrieve_model
+
+    async def available_models():
+        out = await orig_list()
+        base = out.data[0]
+        for a in ALIASES:
+            if all(c.id != a for c in out.data):
+                out.data.append(base.model_copy(update={"id": a, "root": base.id}))
+        return out
+
+    async def retrieve_model(model: str):
+        if model in ALIASES:
+            out = await orig_get(module._global_state.tokenizer_manager.served_model_name)
+            return out.model_copy(update={"id": model}) if hasattr(out, "model_copy") else out
+        return await orig_get(model)
+
+    swap = {"/v1/models": available_models, "/v1/models/{model:path}": retrieve_model}
+    n = 0
+    for r in module.app.router.routes:
+        if isinstance(r, APIRoute) and r.path in swap and "GET" in r.methods:
+            # keep the route and its (SGLang custom) handler; only the function it calls changes, same signature
+            r.endpoint = r.dependant.call = swap[r.path]
+            n += 1
+    logger.warning("DSV41 model aliases: %s (%d routes)", ", ".join(ALIASES), n)
